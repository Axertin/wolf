{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC, static CRT, RelWithDebInfo with PDBs (release build, Windows)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "llvm-mingw, RelWithDebInfo with PDBs (daily dev build)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "toolchainFile": "${sourceDir}/cmake/llvm-mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "WOLF_PDB": "ON"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "llvm-mingw, Debug with DWARF (gdb under Wine)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "toolchainFile": "${sourceDir}/cmake/llvm-mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc", "configurePreset": "msvc" },
    { "name": "mingw-release", "configurePreset": "mingw-release" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" }
  ],
  "testPresets": [
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300 }
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300 }
    },
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300 }
    }
  ]
}
